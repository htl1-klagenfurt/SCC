// ── Libraries ──────────────────────────────────────────────
#include <LedControl.h>
#include <Wire.h>
#include <MPU6050.h>
#include <RTClib.h>
#include <DHT.h>

// ── Pins ───────────────────────────────────────────────────
const int TOUCH_PIN_01 = D5;
const int TOUCH_PIN_02 = D6;

const int DHT_PIN = D4;

const int BUZZER_PIN = D7;

const int DIN_PIN = D8;
const int CS_PIN  = D3;
const int CLK_PIN = D0;
LedControl lc = LedControl(DIN_PIN, CLK_PIN, CS_PIN, 2);

// ── Sensors ────────────────────────────────────────────────
MPU6050 mpu(0x69);
RTC_DS1307 rtc;
DHT dht(DHT_PIN, DHT22);

// ── Modes ──────────────────────────────────────────────────
enum MODE {
  HOURGLASS,
  CLOCK,
  INFO,
  EASTEREGG,
};

MODE currentMode = HOURGLASS;
MODE lastMode    = currentMode;

bool alarm_active = false;

// ── EasterEgg ──────────────────────────────────────────────
enum EASTEREGGS {
  ANIMATION,
  MAZE,

  EASTEREGG_COUNT
};

EASTEREGGS currentEasterEgg = ANIMATION;

// -- Animations ---------------------------------------------
struct Animation {
  const byte (*frames)[2][8][8];
  unsigned int speed;
  int frameCount;
};

