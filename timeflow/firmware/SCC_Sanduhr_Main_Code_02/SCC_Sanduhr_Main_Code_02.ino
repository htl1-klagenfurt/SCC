void SetGravity() {
  int16_t ax, ay, az, gx_, gy_, gz_;
  mpu.getMotion6(&ax, &ay, &az, &gx_, &gy_, &gz_);

  // Kompensation: Gyro um +90° um Y-Achse gedreht
  // Original: (ax, ay, az) → Korrigiert: (-az, ay, ax)
  int16_t rax = -az;
  int16_t ray =  ay;
  int16_t raz =  ax;

  // Shake detection
  float magnitude = sqrt((float)rax*rax + (float)ray*ray + (float)raz*raz);
  float deviation = abs(magnitude - 16384);

  if (deviation > SHAKE_THRESHOLD) {
    shakeCount++;
    if (shakeCount >= SHAKE_MIN_COUNT) {
      shaking = true;
      lastShake = now;
    }
  } else if (now - lastShake >= SHAKE_COOLDOWN) {
    shaking = false;
    shakeCount = 0;
  }

  // Gravity detection
  fax = ALPHA * rax + (1.0f - ALPHA) * fax;
  fay = ALPHA * ray + (1.0f - ALPHA) * fay;

  if (fax*fax + fay*fay < 8000*8000) {
    currentGravity = BACK;
    return;
  }

  float angle = atan2(-fay, -fax) * 180.0f / M_PI - 22.5f + 180.0f;
  if (angle >  180.0f) angle -= 360.0f;
  if (angle < -180.0f) angle += 360.0f;

  int sector = (int)floor(angle / 45.0f) % 8;
  sector += 1;
  if (sector < 0) sector += 8;
  currentGravity = (Gravity)sector;
}

void StepSand() {
  if (currentGravity == BACK) return;
  for (int i = 0; i < 2; i++) {
    byte next[8][8];
    memcpy(next, display[i], sizeof(next));

    const int8_t (*dirs)[2] = checks[currentGravity];

    bool reverseX = random(2);
    bool reverseY = random(2);

    for (int xi = 0; xi < 8; xi++) {
      int x = reverseX ? (7 - xi) : xi;
      for (int yi = 0; yi < 8; yi++) {
        int y = reverseY ? (7 - yi) : yi;

        if (!display[i][x][y]) continue;

        int order[3] = {0, 1, 2};
        if (random() % 2) { order[1] = 2; order[2] = 1; }

        for (int d = 0; d < 3; d++) {
          int nx = x + dirs[order[d]][0];
          int ny = y + dirs[order[d]][1];

          if (nx < 0 || nx > 7 || ny < 0 || ny > 7) continue;
          if (display[i][nx][ny] || next[nx][ny])   continue;

          if (order[d] != 0) {
            int sx = x + dirs[0][0];
            int sy = y + dirs[0][1];
            bool straightBlocked = (sx < 0 || sx > 7 || sy < 0 || sy > 7) || display[i][sx][sy] || next[sx][sy];
            if (!straightBlocked) continue;
          }

          next[nx][ny] = 1;
          next[x][y]   = 0;
          break;
        }
      }
    }

    memcpy(display[i], next, sizeof(next));
  }
}

void StepBurst() {
  for (int i = 0; i < 2; i++) {
    byte next[8][8];
    memcpy(next, display[i], sizeof(next));

    for (int x = 0; x < 8; x++) {
      for (int y = 0; y < 8; y++) {
        if (display[i][x][y]) {

          int r1 = (int)random(3);
          int r2 = (int)random(3);
          int nx = constrain(x + r1 - 1, 0, 7);
          int ny = constrain(y + r2 - 1, 0, 7);

          if (next[nx][ny] == 0) {
            next[nx][ny] = 1;
            next[x][y]   = 0;
          }
        }
      }
    }

    memcpy(display[i], next, sizeof(next));
  }
}

void HandleShortPress() {
  if (settings_menu) {

    if (setting_timer_hours) {
      hourglass_hours = (hourglass_hours + 1) % 10;
      temp_number = hourglass_hours / 10; face_options[0] = '0' + temp_number; temp_number = hourglass_hours % 10; face_options[1] = '0' + temp_number;
    }
    else if (setting_timer_minutes) {
      hourglass_minutes = (hourglass_minutes + 1) % 60;
      temp_number = hourglass_minutes / 10; face_options[0] = '0' + temp_number; temp_number = hourglass_minutes % 10; face_options[1] = '0' + temp_number;
    }
    else if (setting_timer_seconds) {
      hourglass_seconds = (hourglass_seconds + 1) % 60;
      if(hourglass_hours == 0 && hourglass_minutes == 0 && hourglass_seconds < 5) hourglass_seconds = 5;
      temp_number = hourglass_seconds / 10; face_options[0] = '0' + temp_number; temp_number = hourglass_seconds % 10; face_options[1] = '0' + temp_number;
    }
    else if (setting_alarm_hours) {
      alarm_hours = (alarm_hours + 1) % 24;
      temp_number = alarm_hours / 10; face_options[0] = '0' + temp_number; temp_number = alarm_hours % 10; face_options[1] = '0' + temp_number;
    }
    else if (setting_alarm_minutes) {
      alarm_minutes = (alarm_minutes + 1) % 60;
      temp_number = alarm_minutes / 10; face_options[0] = '0' + temp_number; temp_number = alarm_minutes % 10; face_options[1] = '0' + temp_number;
    }
    else if (setting_rtc_hours) {
      clock_hours = (clock_hours + 1) % 24;
      temp_number = clock_hours / 10; face_options[0] = '0' + temp_number; temp_number = clock_hours % 10; face_options[1] = '0' + temp_number;
    }
    else if (setting_rtc_minutes) {
      clock_minutes = (clock_minutes + 1) % 60;
      temp_number = clock_minutes / 10; face_options[2] = '0' + temp_number; temp_number = clock_minutes % 10; face_options[3] = '0' + temp_number;
    }
    return;
  }

  switch (currentMode) {
    case HOURGLASS:
      if (currentGravity == LEFT) {
        currentMode = CLOCK;
      }
      else if (currentGravity == RIGHT) {
        currentMode = INFO;
      }
      else if (currentGravity == BACK) {
        currentMode = EASTEREGG;
      }
      break;

    case CLOCK:
      if (!alarm_active) {
        if(currentGravity == DOWN || currentGravity == UP){
          currentMode = HOURGLASS;
        }
        else if(currentGravity == RIGHT){
          currentMode = INFO;
        }
        else if (currentGravity == BACK) {
          currentMode = EASTEREGG;
        }
      }
      break;

    case INFO:
      if (currentGravity == DOWN || currentGravity == UP){
        currentMode = HOURGLASS;
      }
      else if(currentGravity == LEFT){
        currentMode = CLOCK;
      }
      else if (currentGravity == BACK) {
        currentMode = EASTEREGG;
      }
      break;

    case EASTEREGG:
      if (currentEasterEgg == MAZE) {
        HandleMazeMove();
      }
      else {
        if (currentGravity == DOWN || currentGravity == UP){
          currentMode = HOURGLASS;
        }
        else if(currentGravity == LEFT){
          currentMode = CLOCK;
        }
        else if (currentGravity == RIGHT) {
          currentMode = INFO;
        }
      }
      break;
  }
}

void HandleMiddlePress() {
  
  if (setting_timer_hours) {
    hourglass_hours = hourglass_hours - 1;
    if(hourglass_hours < 0) hourglass_hours = 9;
    temp_number = hourglass_hours / 10; face_options[0] = '0' + temp_number; temp_number = hourglass_hours % 10; face_options[1] = '0' + temp_number;
  }
  else if (setting_timer_minutes) {
    hourglass_minutes = hourglass_minutes - 1;
    if(hourglass_minutes < 0) hourglass_minutes = 59;
    temp_number = hourglass_minutes / 10; face_options[0] = '0' + temp_number; temp_number = hourglass_minutes % 10; face_options[1] = '0' + temp_number;
  }
  else if (setting_timer_seconds) {
    hourglass_seconds = hourglass_seconds - 1;
    if(hourglass_hours == 0 && hourglass_minutes == 0 && hourglass_seconds < 5 || hourglass_seconds < 0) hourglass_seconds = 59;
    temp_number = hourglass_seconds / 10; face_options[0] = '0' + temp_number; temp_number = hourglass_seconds % 10; face_options[1] = '0' + temp_number;
  }
  else if (setting_alarm_hours) {
    alarm_hours = alarm_hours - 1;
    if(alarm_hours < 0) alarm_hours = 23;
    temp_number = alarm_hours / 10; face_options[0] = '0' + temp_number; temp_number = alarm_hours % 10; face_options[1] = '0' + temp_number;
  }
  else if (setting_alarm_minutes) {
    alarm_minutes = alarm_minutes - 1;
    if(alarm_minutes < 0) alarm_minutes = 59;
    temp_number = alarm_minutes / 10; face_options[0] = '0' + temp_number; temp_number = alarm_minutes % 10; face_options[1] = '0' + temp_number;
  }
  else if (setting_rtc_hours) {
    clock_hours = clock_hours - 1;
    if(clock_hours < 0) clock_hours = 23;
    temp_number = clock_hours / 10; face_options[0] = '0' + temp_number; temp_number = clock_hours % 10; face_options[1] = '0' + temp_number;
  }
  else if (setting_rtc_minutes) {
    clock_minutes = clock_minutes - 1;
    if(clock_minutes < 0) clock_minutes = 59;
    temp_number = clock_minutes / 10; face_options[2] = '0' + temp_number; temp_number = clock_minutes % 10; face_options[3] = '0' + temp_number;
  }
}

void HandleLongPress() {
  if (settings_menu) {

    if (setting_timer_hours) {
      setting_timer_hours = false;
      setting_timer_minutes = true;
      face_options[0] = '0'; face_options[1] = '0'; face_options[2] = 'M';
    }
    else if (setting_timer_minutes) {
      setting_timer_minutes = false;
      setting_timer_seconds = true;
      if(hourglass_hours == 0 && hourglass_minutes == 0) hourglass_seconds = 5;
      face_options[0] = '0'; face_options[1] = '0' + hourglass_seconds; face_options[2] = 'S';
    }
    else if (setting_timer_seconds) {    
      setting_timer_seconds = false;
      settings_menu = false;

      CalcTraverseInterval();
      PlaceRandomSand();
    }
    else if (setting_alarm_hours) {
      setting_alarm_hours = false;
      setting_alarm_minutes = true;
      face_options[0] = '0' + (alarm_minutes / 10); face_options[1] = '0' + (alarm_minutes % 10); face_options[2] = 'M';
    }
    else if (setting_alarm_minutes) {
      setting_alarm_minutes = false;
      settings_menu = false;
      alarm_active = true;
    }
    else if (setting_rtc_hours) {
      setting_rtc_hours = false;
      setting_rtc_minutes = true;
    }
    else if (setting_rtc_minutes) {
      setting_rtc_minutes = false;
      settings_menu = false;
      timer_started_01 = false;
      timer_started_02 = false;
      tone_short = false; tone_middle = false; tone_long = false; tone_extra = false; long_press_handled = false;
      rtc.adjust(DateTime(rtc.now().year(), rtc.now().month(), rtc.now().day(), clock_hours, clock_minutes, 0));
    }
    return;
  }

  switch (currentMode) {
    case HOURGLASS:
      settings_menu       = true;
      setting_timer_hours = true;
      hourglass_hours   = 0;
      hourglass_minutes = 0;
      hourglass_seconds = 0;
      face_options[0] = '0'; face_options[1] = '0'; face_options[2] = 'H'; face_options[3] = 'X';
      break;

    case CLOCK:
      if (alarm_active) {
        alarm_active = false;
        alarm_buzzer = false;
        alarm_symbol = false;

        timer_started_01 = false;
        timer_started_02 = false;
        tone_short = false; tone_middle = false; tone_long = false; tone_extra = false; long_press_handled = false;
      } 
      else {
        settings_menu = true;
        setting_alarm_hours = true;
        alarm_hours = clock_hours;
        alarm_minutes = clock_minutes;
        face_options[0] = '0' + (alarm_hours / 10); face_options[1] = '0' + (alarm_hours % 10); face_options[2] = 'H'; face_options[3] = 'X';
      }
      break;

    case INFO:
      break;
    case EASTEREGG:
      currentEasterEgg = (EASTEREGGS)((currentEasterEgg + 1) % EASTEREGG_COUNT);
      break;
  }
}

void adjust_rtc() {
  setting_alarm_hours = false;
  setting_rtc_hours   = true;
  face_options[0] = '0' + (clock_hours / 10);
  face_options[1] = '0' + (clock_hours % 10);
  face_options[2] = '0' + (clock_minutes / 10);
  face_options[3] = '0' + (clock_minutes % 10);
}

void CheckPress() {
  if (time_changed) {
    time_changed = false;
    
    if(measured_time < 300) {
      HandleShortPress();
    }
    else if(measured_time < 1000 && settings_menu) {
      HandleMiddlePress();
    }

    tone_short = false; tone_middle = false; tone_long = false; tone_extra = false; long_press_handled = false;
  }
  else if(timer_started_01 || timer_started_02){
    measured_time = millis() - start_time;

    if(!tone_short && measured_time >= 0){
      if(currentMode == EASTEREGG && currentEasterEgg == MAZE) tone(BUZZER_PIN, 5000, 20);
      else tone(BUZZER_PIN, 2000, 20);
      tone_short = true;
    }
    else if(!tone_middle && settings_menu && measured_time >= 300){
      tone(BUZZER_PIN, 2000, 20);
      tone_middle = true;
    }
    else if(!tone_long && currentMode != INFO && measured_time >= 1000){
      tone(BUZZER_PIN, 2000, 20);
      tone_long = true;
    }
    else if(!tone_extra && currentMode == CLOCK && measured_time >= 3000 && !setting_alarm_minutes && !setting_rtc_hours && !setting_rtc_minutes){
      tone(BUZZER_PIN, 2000, 20);
      tone_extra = true;
    }

    if(!long_press_handled && measured_time >= 1000){
      long_press_handled = true;
      HandleLongPress();
    }
    else if(currentMode == CLOCK && measured_time >= 3000 && !setting_alarm_minutes && !setting_rtc_hours && !setting_rtc_minutes){
      adjust_rtc();
      timer_started_01 = false;
      timer_started_02 = false;
      tone_short = false; tone_middle = false; tone_long = false; tone_extra = false; long_press_handled = false;
    }
  }
}

void FlushDisplays() {
  for (int i = 0; i < 2; i++) {
    lc.shutdown(i, false);
    lc.setScanLimit(i, 7);
    lc.setIntensity(i, 1);
  }
}

void UpdateDisplays() {
  FlushDisplays();
  for (int i = 0; i < 2; i++) {
    int rot = (i == 0) ? DISPLAY_0_ROTATION : DISPLAY_1_ROTATION;

    for (int j = 0; j < 8; j++) {
      byte row = 0;
      for (int k = 0; k < 8; k++) {
        bool pixel;
        switch (rot) {
          case 0: pixel = display[i][j][k];         break; // 0°
          case 1: pixel = display[i][7 - k][j];     break; // 90° CW
          case 2: pixel = display[i][7 - j][7 - k]; break; // 180°
          case 3: pixel = display[i][k][7 - j];     break; // 270° CW
        }
        if (pixel) row |= (1 << (7 - k));
      }
      lc.setRow(i, j, row);
    }
  }
}

// ── Easter Egg ──────────────────────────────────────────────
void PlayAnimation() {
  static int currentAnimation = 0;
  static bool lastShaking = false;

  if (shaking && !lastShaking) {
    currentAnimation = (currentAnimation + 1) % ANIMATION_COUNT;
    frame = 0;
  }
  lastShaking = shaking;

  const Animation& anim = animations[currentAnimation];
  if (now - lastFrame >= anim.speed) {
    lastFrame = now;
    frame = (frame + 1) % anim.frameCount;
    memcpy(display, anim.frames[frame], sizeof(display));
  }
}

inline uint16_t encodeCell(uint8_t x, uint8_t y) { return y * 65 + x; }
inline uint8_t  cellX(uint16_t c)                { return c % 65; }
inline uint8_t  cellY(uint16_t c)                { return c / 65; }

void GenerateMaze(MazeDifficulty diff) {
    switch (diff) {
        case TINY:   mazeN = 9;  break;
        case SMALL:  mazeN = 17; break;
        case MEDIUM: mazeN = 33; break;
        case LARGE:  mazeN = 65; break;
    }
    mazeOffset = (65 - mazeN) / 2;

    // Fill everything with walls
    memset(maze, 1, sizeof(maze));

    // ── Growing Tree ──────────────────────────────────────────────
    uint16_t treeSize = 0;

    // Pick a random starting cell (odd indices = cell positions)
    uint8_t startX = mazeOffset + (random(mazeN / 2) * 2 + 1);
    uint8_t startY = mazeOffset + (random(mazeN / 2) * 2 + 1);
    maze[startY][startX] = 0;
    buf[treeSize++] = encodeCell(startX, startY);

    while (treeSize > 0) {
        // 80% newest, 20% random
        uint16_t idx = (random(100) < 80)
            ? treeSize - 1
            : random(treeSize);

        uint8_t cx = cellX(buf[idx]);
        uint8_t cy = cellY(buf[idx]);

        // Collect unvisited neighbours (2 steps away)
        uint8_t nx[4], ny[4];
        uint8_t nCount = 0;
        const int8_t dx[] = { 0, 0, -2, 2 };
        const int8_t dy[] = { -2, 2, 0, 0 };
        for (uint8_t d = 0; d < 4; d++) {
            int8_t fx = cx + dx[d];
            int8_t fy = cy + dy[d];
            if (fx >= mazeOffset && fx < mazeOffset + mazeN &&
                fy >= mazeOffset && fy < mazeOffset + mazeN &&
                maze[fy][fx] == 1) {
                nx[nCount] = fx;
                ny[nCount] = fy;
                nCount++;
            }
        }

        if (nCount == 0) {
            // Dead end — remove this cell from active list
            buf[idx] = buf[--treeSize];
        } else {
            // Carve into a random unvisited neighbour
            uint8_t pick = random(nCount);
            uint8_t wallX = (cx + nx[pick]) / 2;
            uint8_t wallY = (cy + ny[pick]) / 2;
            maze[wallY][wallX] = 0;
            maze[ny[pick]][nx[pick]] = 0;
            buf[treeSize++] = encodeCell(nx[pick], ny[pick]);
        }
    }

    const int8_t bx[] = { 0, 0, -1, 1 };
    const int8_t by[] = { -1, 1,  0, 0 };

    // ── Find maze diameter for start/goal placement ───────────────
    auto bfs = [&](uint8_t sx, uint8_t sy) -> uint16_t {
        uint16_t head = 0, tail = 0;
        // Clear previous BFS markers
        for (uint8_t y = mazeOffset; y < mazeOffset + mazeN; y++)
            for (uint8_t x = mazeOffset; x < mazeOffset + mazeN; x++)
                if (maze[y][x] == 4) maze[y][x] = 0;

        maze[sy][sx] = 4;
        buf[tail++] = encodeCell(sx, sy);
        uint16_t lastCell = encodeCell(sx, sy);

        while (head < tail) {
            uint16_t cur = buf[head++];
            uint8_t cx = cellX(cur);
            uint8_t cy = cellY(cur);
            lastCell = cur;
            for (uint8_t d = 0; d < 4; d++) {
                int8_t fx = cx + bx[d];
                int8_t fy = cy + by[d];
                if (fx >= mazeOffset && fx < mazeOffset + mazeN &&
                    fy >= mazeOffset && fy < mazeOffset + mazeN &&
                    maze[fy][fx] == 0) {
                    maze[fy][fx] = 4;
                    buf[tail++] = encodeCell(fx, fy);
                }
            }
        }
        return lastCell;
    };

    uint16_t cellA = bfs(startX, startY);
    uint16_t cellB = bfs(cellX(cellA), cellY(cellA));

    // Clean up markers
    for (uint8_t y = mazeOffset; y < mazeOffset + mazeN; y++)
        for (uint8_t x = mazeOffset; x < mazeOffset + mazeN; x++)
            if (maze[y][x] == 4) maze[y][x] = 0;

    maze[cellY(cellA)][cellX(cellA)] = 3; // start
    maze[cellY(cellB)][cellX(cellB)] = 2; // goal
}

void HandleMazeMove() {
  // Spieler finden
  int pr = -1, pc = -1;
  for (int i = 0; i < 65 && pr == -1; i++)
    for (int j = 0; j < 65 && pr == -1; j++)
      if (maze[i][j] == 3) { pr = i; pc = j; }

  if (pr == -1) return;

  // Gravity → Bewegungsrichtung
  int dr = 0, dc = 0;
  switch (currentGravity) {
    case DOWN_RIGHT: dr =  1; dc =  0; break;
    case DOWN_LEFT:  dr =  0; dc = -1; break;
    case UP_RIGHT:   dr =  0; dc =  1; break;
    case UP_LEFT:    dr = -1; dc =  0; break;
    default: return;
  }

  int nr = pr + dr;
  int nc = pc + dc;

  // Bounds + Wand-Check
  if (nr < 0 || nr >= 65 || nc < 0 || nc >= 65) return;
  if (maze[nr][nc] == 1) return; // Wand

  // Ziel erreicht?
  if (maze[nr][nc] == 2) {
    tone(BUZZER_PIN, 3000, 300);
    maze[pr][pc] = 0;
    maze[nr][nc] = 3;
    UpdateDisplays();
    delay(1000);
    // Schwierigkeit erhöhen
    currentDifficulty = (MazeDifficulty)((currentDifficulty + 1) % 4);
    GenerateMaze(currentDifficulty);
    return;
  }

  // Normaler Schritt
  maze[pr][pc] = 0;
  maze[nr][nc] = 3;
}

void DrawMaze() {
  int playerRow = -1, playerCol = -1;
  int goalRow   = -1, goalCol   = -1;

  for (int i = 0; i < 65; i++) {
    for (int j = 0; j < 65; j++) {
      if (maze[i][j] == 3) { playerRow = i; playerCol = j; }
      if (maze[i][j] == 2) { goalRow   = i; goalCol   = j; }
    }
  }

  if (playerRow == -1) return;

  // ── Maze auf display[0] ────────────────────────────────
  for (int di = 0; di < 8; di++) {
    for (int dj = 0; dj < 8; dj++) {
      int i = playerRow - 4 + di;
      int j = playerCol - 4 + dj;

      uint8_t cell = (i >= 0 && i < 65 && j >= 0 && j < 65) ? maze[i][j] : 1;

      if      (cell == 0) display[0][di][dj] = 0;
      else if (cell == 1) display[0][di][dj] = 1;
      else if (cell == 2) { if (now - last_end_blink    >= END_INTERVAL   ) { last_end_blink    = now; end_blink_state    = !end_blink_state;    } display[0][di][dj] = end_blink_state    ? 1 : 0; }
      else if (cell == 3) { if (now - last_player_blink >= PLAYER_INTERVAL) { last_player_blink = now; player_blink_state = !player_blink_state; } display[0][di][dj] = player_blink_state ? 1 : 0; }
    }
  }

  // ── Pfeil auf display[1] ───────────────────────────────
  if (goalRow == -1) return;

  int dr = goalRow   - playerRow;
  int dc = goalCol   - playerCol;

  // Winkel in Grad: 0° = oben, 90° = rechts, 180° = unten, 270° = links
  float angle = atan2((float)dc, (float)-dr) * 180.0f / M_PI;
  if (angle < 0) angle += 360.0f;

  // Ist die Richtung diagonal (45°, 135°, 225°, 315°) oder gerade (0°, 90°, 180°, 270°)?
  int rotSteps45  = (int)round(angle / 45.0f) % 8;  // für Diagonalen
  bool isDiagonal = (rotSteps45 % 2) == 1;           // ungerade = diagonal

  int arrowIndex = isDiagonal ? 0 : 1;               // 0 = schräg, 1 = gerade
  int rotSteps   = isDiagonal ? (rotSteps45 / 2)     // diagonal: /2 wegen 45°-Schritten
                              : (rotSteps45 / 2) % 4; // gerade: direkt

  byte arrow[8][8];
  memcpy(arrow, maze_arrows[arrowIndex], sizeof(arrow));
  RotateGrid(arrow, rotSteps);

  memcpy(display[1], arrow, sizeof(arrow));
}