// ── Interrupts ─────────────────────────────────────────────
void IRAM_ATTR handleTouch1() {
  if(!time_changed && !timer_started_02){
    if (digitalRead(TOUCH_PIN_01) == HIGH && digitalRead(TOUCH_PIN_02) == LOW) {
      start_time = millis();
      timer_started_01 = true;
    } 
    else if(timer_started_01){
      measured_time = millis() - start_time;
      timer_started_01 = false;
      time_changed = true;
    }
  }
}

void IRAM_ATTR handleTouch2() {
  if(!time_changed && !timer_started_01){
    if (digitalRead(TOUCH_PIN_02) == HIGH && digitalRead(TOUCH_PIN_01) == LOW) {
      start_time = millis();
      timer_started_02 = true;
    } 
    else if(timer_started_02){
      measured_time = millis() - start_time;
      timer_started_02 = false;
      time_changed = true;
    }
  }
}

// ── Setup ──────────────────────────────────────────────────
void setup() {

  Wire.begin(D2, D1);
  mpu.initialize();

  rtc.begin();

  if (!rtc.isrunning() || rtc.now().year() < 2024) {
    rtc.adjust(DateTime(F(__DATE__), F(__TIME__)) + TimeSpan(0, 0, 0, 15));
  }

  dht.begin();

  pinMode(TOUCH_PIN_01, INPUT);
  pinMode(TOUCH_PIN_02, INPUT);
  pinMode(DIN_PIN, OUTPUT);
  pinMode(CS_PIN,  OUTPUT);
  pinMode(CLK_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  lc.shutdown(0, false);  lc.setIntensity(0, 1);  lc.clearDisplay(0);
  lc.shutdown(1, false);  lc.setIntensity(1, 1);  lc.clearDisplay(1);

  attachInterrupt(digitalPinToInterrupt(TOUCH_PIN_01), handleTouch1, CHANGE);
  attachInterrupt(digitalPinToInterrupt(TOUCH_PIN_02), handleTouch2, CHANGE);

  PlaceRandomSand();
  CalcTraverseInterval();
}

// ── Loop ───────────────────────────────────────────────────
void loop(){
  now = millis();

  SetGravity();
  CheckPress();

  // On Mode Change
  if (currentMode != lastMode) {
    switch (currentMode) {
      case HOURGLASS: PlaceRandomSand();       break;
      case CLOCK:                              break;
      case INFO:                               break;
      case 
        EASTEREGG: frame =  0;
        GenerateMaze(currentDifficulty);           
        break;
      default:                                 break;
    }
    
    lastMode = currentMode;
  }

  // Mode-Specific Actions
  switch (currentMode){
    case HOURGLASS:
      if (!settings_menu) {
        if (now - lastSandStep >= SAND_INTERVAL) {
          lastSandStep = now;
          if (shaking) StepBurst();
          else         StepSand();
        }
        if (now - lastTraverse >= traverseInterval) {
          lastTraverse = now;
          Traverse();
        }
      }
      else ShowSymbols(face_options);
      break;
    case CLOCK:
      if(!settings_menu) ReadTime();
      ShowSymbols(face_options);

      break;
    case INFO:
      ReadDHT();
      ShowSymbols(face_options);

      break;
    case EASTEREGG:
      switch (currentEasterEgg) {
        case ANIMATION: PlayAnimation();   break;
        case MAZE:      DrawMaze();        break; 
        default:                           break;
      }
      break;
    default: break;
  }

  UpdateDisplays();
}

// ── Functions ───────────────────────────────────────────────
void ClearDisplay() {
  memset(display, 0, sizeof(display));
}

void ReadTime() {

  DateTime time = rtc.now();
  
  clock_hours = time.hour();
  clock_minutes = time.minute();
  
  if(alarm_buzzer){

    if(millis() - alarm_buzzer_interval >= 1000){

      alarm_buzzer_interval = millis();
      tone(BUZZER_PIN, 2000, 700);
    }
  }
  else if(alarm_active){
    if(clock_hours == alarm_hours && clock_minutes == alarm_minutes){
      alarm_buzzer = true;
    }
  }

  face_options[0] = '0' + (clock_hours   / 10);
  face_options[1] = '0' + (clock_hours   % 10);
  face_options[2] = '0' + (clock_minutes / 10);
  face_options[3] = '0' + (clock_minutes % 10);

}

void ReadDHT() {
  
  humidity    = (int)round(dht.readHumidity());
  temperature = (int)round(dht.readTemperature());

  if (isnan(humidity) || isnan(temperature)) {
    return;
  }
  else{
    if(millis() - info_swap_interval >= 3000){
      info_swap_interval = millis();
      temperature_mode = !temperature_mode;
    }

    if(temperature_mode){
      temp_number = temperature / 10; face_options[0] = '0' + temp_number;
      temp_number = temperature % 10; face_options[1] = '0' + temp_number;
      face_options[2] = 'C';
      if(temperature < 0) face_options[3] = 'N';
      else face_options[3] = 'X';
    }
    else{
      temp_number = humidity / 10; face_options[0] = '0' + temp_number;
      temp_number = humidity % 10; face_options[1] = '0' + temp_number;
      face_options[2] = '%';
      face_options[3] = 'X';
    }
  }
}

void AddSymbolToDisplay(byte display[8][8], int index) {
  for (int x = 0; x < 8; x++)
    for (int y = 0; y < 8; y++)
      if (symbols[index][x][y]) display[x][y] = 1;
}

void RotateGrid(byte grid[8][8], int times) {
  byte temp[8][8];
  times = times % 4; // Ensure it's 0-3
  if (times == 0) return;

  for (int r = 0; r < 8; r++) {
    for (int c = 0; c < 8; c++) {
      if (times == 1)                 // 90° CW
        temp[c][7 - r] = grid[r][c];
      else if (times == 2)            // 180°
        temp[7 - r][7 - c] = grid[r][c];
      else if (times == 3)            // 270° CW
        temp[7 - c][r] = grid[r][c];
    }
  }
  memcpy(grid, temp, sizeof(temp));
}

void ShowSymbols(char data[4]) {
  ClearDisplay();

  // Set Rotation and Swap
  switch (currentGravity) {
    case DOWN:  rotation = 0; swap = false; break; // nothing
    case UP:    rotation = 2; swap = true;  break; // 180° + swap
    case LEFT:  rotation = 1; swap = false; break; // 90° CW
    case RIGHT: rotation = 3; swap = true;  break; // 270° CW + swap
    default:                                break; // diagonal -> stay
  }

  byte tempA[8][8] = {};  // will hold "first  matrix" content
  byte tempB[8][8] = {};  // will hold "second matrix" content

  // Numbers
  AddSymbolToDisplay(tempA, data[0] - '0');
  AddSymbolToDisplay(tempA, data[1] - '0' + 10);

  // Letter
  switch(data[2]){
    case 'H': AddSymbolToDisplay(tempB, 20); break;
    case 'M': AddSymbolToDisplay(tempB, 21); break;
    case 'S': AddSymbolToDisplay(tempB, 22); break;
    case 'C': AddSymbolToDisplay(tempB, 23); break;
    case '%': AddSymbolToDisplay(tempB, 24); break;
    default:  AddSymbolToDisplay(tempB, data[2] - '0'); break;
  }

  // Negative Sign
  if (data[3] == 'N') tempA[0][0] = 1;
  else if (data[3] == 'X'); // Do nothing
  else AddSymbolToDisplay(tempB, data[3] - '0' + 10);

  if(alarm_active){

    if(millis() - alarm_interval >= 500){
      alarm_interval = millis();
      alarm_symbol = !alarm_symbol;
    }
  
    if(alarm_symbol){
      if(currentGravity == UP || currentGravity == DOWN) alarm_index = true;
      else if(currentGravity == RIGHT || currentGravity == LEFT) alarm_index = false;

      if(alarm_index){
        tempA[7][0] = 1;
        tempB[0][7] = 1;
      }
      else{
        tempA[7][7] = 1;
        tempB[0][0] = 1;
      }
    }
  }

  if(setting_rtc_hours || setting_rtc_minutes){
    if(rtc_symbol){
      if(setting_rtc_hours) memset(tempA, 0, sizeof(tempA));
      else memset(tempB, 0, sizeof(tempB));

      if(millis() - rtc_interval >= 400){
        rtc_interval = millis();
        rtc_symbol = !rtc_symbol;
      }
    }
    else{
      if(millis() - rtc_interval >= 1200){
        rtc_interval = millis();
        rtc_symbol = !rtc_symbol;
      }
    }
  }

  // Apply Rotation and Swap
  RotateGrid(tempA, rotation);
  RotateGrid(tempB, rotation);

  if (swap) {
    for (int r = 0; r < 8; r++) {
      for (int c = 0; c < 8; c++) {
        byte hold = tempA[r][c];
        tempA[r][c] = tempB[r][c];
        tempB[r][c] = hold;
      }
    }
  }

  memcpy(display[0], tempA, sizeof(tempA));
  memcpy(display[1], tempB, sizeof(tempB));
}

void PlaceRandomSand() {
    ClearDisplay();

    int d = 1;

    if(currentGravity == DOWN) d = 0;

    // Shuffle all 64 positions, place sand in first `count`
    byte positions[64];
    for (int i = 0; i < 64; i++) positions[i] = i;

    for (int i = 0; i < N_SAND; i++) {
        int j = i + random(64 - i);
        byte tmp = positions[i]; positions[i] = positions[j]; positions[j] = tmp;

        int x = positions[i] % 8;
        int y = positions[i] / 8;
        display[d][y][x] = 1;
    }
}

void CalcTraverseInterval() {
  traverseInterval = (((hourglass_hours * 60 + hourglass_minutes) * 60 + hourglass_seconds) * 1000) / N_SAND; 
}

void Traverse() {
  switch (currentGravity){
    case DOWN:
      if (display[0][7][0] && !display[1][0][7]){
        display[0][7][0] = 0;
        display[1][0][7] = 1;
      }
      break;

    case UP:
      if (display[1][0][7] && !display[0][7][0]){
        display[1][0][7] = 0;
        display[0][7][0] = 1;
      }
      break;

    default: break;
  }
}

